{
  "manifest_version": 3,
  "name": "Flowdeck",
  "version": "2.0.0",
  "description": "A grade calculator extension for course management",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/flowdeck-icon.png",
      "48": "icons/flowdeck-icon.png",
      "128": "icons/flowdeck-icon.png"
    }
  },
  "icons": {
    "16": "icons/flowdeck-icon.png",
    "48": "icons/flowdeck-icon.png",
    "128": "icons/flowdeck-icon.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://learn.bcit.ca/*",
    "https://www.bcit.ca/outlines/*",
    "https://site--flowdeck-extensionserver--7hgkydn2hz94.code.run/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://learn.bcit.ca/*"],
      "js": ["content_entry.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models.js", "scrapedata.js"],
      "matches": ["https://learn.bcit.ca/*"]
    }
  ]
}
